# Copy to .env.local for development. In Vercel, set these in Project → Settings → Environment Variables.
# Rule: only NEXT_PUBLIC_* values reach the browser, and those must be safe to publish. Every secret is server-only.
# Full explanation per environment (Development / Preview / Production): ENVIRONMENT.md

# ── Site ──
# Public site URL, no trailing slash. Used for canonical URLs, auth redirects and Paystack's return URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Project Settings → API) ──
# The anon key is designed to be public: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY. Never NEXT_PUBLIC_. Needed to confirm Paystack payments (webhook + return page), sign private
# resource downloads, and send admin invitations. Without it, payments can't be fulfilled.
SUPABASE_SERVICE_ROLE_KEY=

# ── Paystack (Dashboard → Settings → API Keys & Webhooks) ──
# SERVER-ONLY. Use sk_test_… in Development/Preview; sk_live_… only in Production after testing.
PAYSTACK_SECRET_KEY=
# Currencies your Paystack account accepts, comma-separated. Defaults to NGN.
PAYSTACK_CURRENCIES=NGN

# ── Email ──
# Transactional email (purchase, enrolment, certificate, welcome) and the contact form. Without a key nothing is sent.
RESEND_API_KEY=
EMAIL_FROM="Fola Academy <onboarding@resend.dev>"
NEXT_PUBLIC_CONTACT_EMAIL=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Samson Odejinmi <onboarding@resend.dev>"

# ── AI (Admin → AI tools) ──
# SERVER-ONLY. Without it the AI pages explain what's missing and generate nothing.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
AI_MODEL=
# Optional per-feature override, e.g. AI_MODEL_CHATBOT, AI_MODEL_TUTOR, AI_MODEL_QUIZ,
# AI_MODEL_LESSON_ASSISTANT, AI_MODEL_CONTENT, AI_MODEL_REGENERATE.
# Student AI tutor + public Academy chatbot need ANTHROPIC_API_KEY *and* SUPABASE_SERVICE_ROLE_KEY
# (usage limits are counted server-side). Without both, the chat buttons are hidden.
# Max public chatbot requests per day across all visitors (cost ceiling). Default 500.
AI_PUBLIC_DAILY_CAP=
# Optional salt for hashing visitor IPs in the AI log (no raw IPs are stored). Defaults to a server secret.
AI_RATE_SALT=

# ── Batch 3: products, marketing, affiliates ──
# Email provider for transactional + marketing email: "resend" (default) or "none" to switch email off.
EMAIL_PROVIDER=resend
# Optional sender for marketing email (defaults to EMAIL_FROM). Must be a verified sender at your provider.
MARKETING_EMAIL_FROM=
# Optional postal address shown in marketing email footers (recommended for anti-spam laws).
MARKETING_POSTAL_ADDRESS=
# Resend → Webhooks signing secret (whsec_…). Enables delivered/opened/clicked/bounced/complained tracking.
RESEND_WEBHOOK_SECRET=
# Secret for /api/cron/marketing (Vercel Cron sends it automatically). At least 16 random characters.
CRON_SECRET=
# Optional salt for hashing referral-link visitors (de-duplication only). Defaults to AI_RATE_SALT / a server secret.
AFFILIATE_CLICK_SALT=
# WhatsApp (optional, Meta WhatsApp Cloud API). Nothing is sent unless all are set AND the person opted in.
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ── Batch 4: payments + security ──
# Flutterwave (secondary provider, optional). Test keys start FLWSECK_TEST-. Webhook "secret hash" set in the
# Flutterwave dashboard must equal FLUTTERWAVE_WEBHOOK_HASH. Enable it in Admin → Settings → Payment settings.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
# Optional salt for hashing emails/IPs in the security log (defaults to another server secret).
SECURITY_LOG_SALT=

# Optional: more daily website captures for portfolio projects (https://microlink.io). Works without it.
MICROLINK_API_KEY=
