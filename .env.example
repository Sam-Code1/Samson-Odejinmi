# Copy to .env.local for development. In Vercel, set these in Project → Settings → Environment Variables.
# Rule: only NEXT_PUBLIC_* values reach the browser, and those must be safe to publish. Every secret is server-only.
# Full explanation per environment (Development / Preview / Production): ENVIRONMENT.md

# ── Site ──
# Public site URL, no trailing slash. Used for canonical URLs, auth redirects and Paystack's return URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Project Settings → API) ──
# The anon key is designed to be public: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY. Never NEXT_PUBLIC_. Needed to confirm Paystack payments (webhook + return page), sign private
# resource downloads, and send admin invitations. Without it, payments can't be fulfilled.
SUPABASE_SERVICE_ROLE_KEY=

# ── Paystack (Dashboard → Settings → API Keys & Webhooks) ──
# SERVER-ONLY. Use sk_test_… in Development/Preview; sk_live_… only in Production after testing.
PAYSTACK_SECRET_KEY=
# Currencies your Paystack account accepts, comma-separated. Defaults to NGN.
PAYSTACK_CURRENCIES=NGN

# ── Email ──
# Transactional email (purchase, enrolment, certificate, welcome) and the contact form. Without a key nothing is sent.
RESEND_API_KEY=
EMAIL_FROM="Fola Academy <onboarding@resend.dev>"
NEXT_PUBLIC_CONTACT_EMAIL=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Samson Odejinmi <onboarding@resend.dev>"

# ── AI (Admin → AI tools) ──
# SERVER-ONLY. Without it the AI pages explain what's missing and generate nothing.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
AI_MODEL=
