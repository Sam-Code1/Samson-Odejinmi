# Public site URL (no trailing slash). Used for canonical URLs and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings > API. The anon key is safe in the browser (RLS protects data).
# Never put the service-role key in a NEXT_PUBLIC_ variable. This project does not need it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Contact form. Without RESEND_API_KEY the form falls back to a mailto link.
NEXT_PUBLIC_CONTACT_EMAIL=odejinmisamson37@gmail.com
CONTACT_TO_EMAIL=odejinmisamson37@gmail.com
CONTACT_FROM_EMAIL="Samson Odejinmi <onboarding@resend.dev>"
RESEND_API_KEY=

# SERVER-ONLY. Never prefix with NEXT_PUBLIC_. Used only to sign short-lived links for private course files
# (resource downloads) after the student's enrolment is verified. Leave empty to disable file downloads.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack (future). Server-only. The admin Settings page only reports whether it is set.
PAYSTACK_SECRET_KEY=

# AI quiz generator + content assistant (Admin → AI tools). SERVER-ONLY: never prefix with NEXT_PUBLIC_.
# Get a key at https://console.anthropic.com. Without it the AI pages explain what's missing and generate nothing.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
AI_MODEL=
